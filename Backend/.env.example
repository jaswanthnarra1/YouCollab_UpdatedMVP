# --- APPLICATION SETTINGS ---
CLIENT_URL=http://localhost:5173
NODE_ENV=development
PORT=5000

# --- CLERK AUTHENTICATION (Email + Password + Email OTP; phone auth disabled in dashboard) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- DATABASE CONNECTIONS ---
DATABASE_URL=

# --- EMAIL INTEGRATIONS (Gmail SMTP) ---
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create App Password → Mail → Other → copy the 16-char password
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=YouCollab

# --- FILE UPLOAD CONFIGS ---
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# --- INSTAGRAM GRAPH API ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/instagram/callback
# Optional overrides — defaults are 7 days before expiry / every 24h, see config/index.js
INSTAGRAM_REFRESH_BEFORE_EXPIRY_DAYS=7
INSTAGRAM_REFRESH_SWEEP_HOURS=24

# --- TOKEN ENCRYPTION (AES-256-GCM, for stored Instagram access tokens) ---
# 64-char hex string (32 bytes) — generate a UNIQUE one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- SUPABASE SETTINGS ---
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
